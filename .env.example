# Signs the session cookie of the client area and staff portal (lib/auth/token.ts).
# Required in production, at least 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# "Continue with Google" (app/api/auth/google). Create an OAuth client (type: Web application) in the
# Google Cloud console and add <site>/api/auth/google/callback to the authorized redirect URIs.
# Without them, Google sign-in is unavailable and redirects back with an error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set this to the exact public callback URL and allow it in Google Cloud's authorized redirect URIs.
# For production, for example: https://your-domain.example/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Backend API
NEXT_PUBLIC_API_URL=https://wow-quick-bites-backend-ziwt.onrender.com/api/v1
# Server-only shared secret required by POST /auth/google/.
BACKEND_FRONTEND_SECRET=
