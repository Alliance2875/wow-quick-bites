# Signs the session cookie of the client area and staff portal (lib/auth/token.ts).
# Required in production, at least 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# "Continue with Google" (app/api/auth/google). Create an OAuth client (type: Web application) in the
# Google Cloud console and add <site>/api/auth/google/callback to the authorized redirect URIs.
# Without them, development signs in a demo Google account; production shows an error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only when the public URL differs from the request origin (proxy, tunnel)
GOOGLE_REDIRECT_URI=
